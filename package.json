{
  "homepage": "https://soulcodec.github.io/blogcard-tailwind/",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
